# --- Secrets (never commit) ---------------------------------------------
.env
.env.*
# stray env-like dotfiles (e.g. mistyped copies)
.*env
!.env.example
*.pem
*.key
secrets/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- Generated data & outputs (fully reproducible from scripts) ----------
# Raw CSVs are regenerated by scripts/generate_data.py (fixed random seed).
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# --- Power BI local artefacts ----------------------------------------------
*.pbix.bak
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf

# --- IDE / OS ---------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Generator ground-truth labels (regenerated)
data/evaluation/*
!data/evaluation/.gitkeep
